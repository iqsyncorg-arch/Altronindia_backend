# Paste your MongoDB connection string (Atlas or self-hosted)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/altronindia?retryWrites=true&w=majority

PORT=3001

# Protect admin write APIs (send as header: X-Admin-Key)
ADMIN_API_KEY=change-me-to-a-long-random-string

# Used for POST /api/admin/login JWT
JWT_SECRET=change-me-jwt-secret

# * or all = any origin; otherwise comma-separated allowlist
CORS_ORIGIN=*
